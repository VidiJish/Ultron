        </span><span><span class="hljs-built_in">return</span></span><span>

    </span><span><span class="hljs-keyword">if</span></span><span> any(f </span><span><span class="hljs-keyword">in</span></span><span> selected </span><span><span class="hljs-keyword">for</span></span><span> f </span><span><span class="hljs-keyword">in</span></span><span> free_indicators):
        max_tokens = 1024
    </span><span><span class="hljs-keyword">else</span></span><span>:
        max_tokens = 2048

    cfg[</span><span><span class="hljs-string">"model"</span></span><span>] = selected
    cfg[</span><span><span class="hljs-string">"max_tokens"</span></span><span>] = max_tokens
    save_config(cfg)
    </span><span><span class="hljs-built_in">print</span></span><span>(f</span><span><span class="hljs-string">"\n‚úÖ Model set to: {selected} with max_tokens={max_tokens}"</span></span><span>)
EOL

