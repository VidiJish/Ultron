    exit(</span><span><span class="hljs-number">1</span></span><span>)

</span><span><span class="hljs-keyword">for</span></span><span> model </span><span><span class="hljs-keyword">in</span></span><span> data.get(</span><span><span class="hljs-string">"data"</span></span><span>, []):
    </span><span><span class="hljs-built_in">print</span></span><span>(model.get(</span><span><span class="hljs-string">"id"</span></span><span>))
</span></span></code></div></div></pre>
