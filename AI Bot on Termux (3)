<h2 data-start="211" data-end="278">1Ô∏è‚É£ Update <code data-start="225" data-end="248">tools/model_picker.py</code> for auto free-model selection</h2>
<p data-start="280" data-end="332">Replace the current <code data-start="300" data-end="312">pick_model</code> function with this:</p>
<pre class="overflow-visible! px-0!" data-start="334" data-end="2078"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">python</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-c9exbsc1.svg#ce3544" fill="currentColor"></use></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-keyword">import</span></span><span> os, json, requests

CONFIG_PATH = </span><span><span class="hljs-string">"config/config.json"</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">load_config</span></span><span>():
    </span><span><span class="hljs-keyword">with</span></span><span> </span><span><span class="hljs-built_in">open</span></span><span>(CONFIG_PATH) </span><span><span class="hljs-keyword">as</span></span><span> f:
        </span><span><span class="hljs-keyword">return</span></span><span> json.load(f)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">save_config</span></span><span>(</span><span><span class="hljs-params">cfg</span></span><span>):
    </span><span><span class="hljs-keyword">with</span></span><span> </span><span><span class="hljs-built_in">open</span></span><span>(CONFIG_PATH, </span><span><span class="hljs-string">"w"</span></span><span>) </span><span><span class="hljs-keyword">as</span></span><span> f:
        json.dump(cfg, f, indent=</span><span><span class="hljs-number">2</span></span><span>)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">fetch_models</span></span><span>(</span><span><span class="hljs-params">api_key</span></span><span>):
    headers = {
        </span><span><span class="hljs-string">"Authorization"</span></span><span>: </span><span><span class="hljs-string">f"Bearer <span class="hljs-subst">{api_key}</span></span></span><span>",
        </span><span><span class="hljs-string">"HTTP-Referer"</span></span><span>: </span><span><span class="hljs-string">"http://localhost"</span></span><span>
    }
    </span><span><span class="hljs-keyword">try</span></span><span>:
        resp = requests.get(</span><span><span class="hljs-string">"https://openrouter.ai/api/v1/models"</span></span><span>, headers=headers, timeout=</span><span><span class="hljs-number">30</span></span><span>)
        data = resp.json()
        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-string">"error"</span></span><span> </span><span><span class="hljs-keyword">in</span></span><span> data:
            </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è API Error:"</span></span><span>, data[</span><span><span class="hljs-string">"error"</span></span><span>])
            </span><span><span class="hljs-keyword">return</span></span><span> []
        </span><span><span class="hljs-keyword">return</span></span><span> data.get(</span><span><span class="hljs-string">"data"</span></span><span>, [])
    </span><span><span class="hljs-keyword">except</span></span><span> Exception </span><span><span class="hljs-keyword">as</span></span><span> e:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è Failed to fetch models:"</span></span><span>, e)
        </span><span><span class="hljs-keyword">return</span></span><span> []

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">pick_model</span></span><span>(</span><span><span class="hljs-params">auto_free=<span class="hljs-literal">True</span></span></span><span>):
    cfg = load_config()
    api_key = cfg.get(</span><span><span class="hljs-string">"openrouter_key"</span></span><span>)
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> api_key:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è Set OPENROUTER_API_KEY first in config.json"</span></span><span>)
        </span><span><span class="hljs-keyword">return</span></span><span>

    models = fetch_models(api_key)
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> models:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è No models available"</span></span><span>)
        </span><span><span class="hljs-keyword">return</span></span><span>

    free_indicators = [</span><span><span class="hljs-string">":free"</span></span><span>, </span><span><span class="hljs-string">"gpt-3.5"</span></span><span>, </span><span><span class="hljs-string">"gpt-4o-mini"</span></span><span>, </span><span><span class="hljs-string">"openrouter/auto"</span></span><span>]

    </span><span><span class="hljs-comment"># -------- AUTO FREE MODEL SELECTION --------</span></span><span>
    free_models = [m[</span><span><span class="hljs-string">'id'</span></span><span>] </span><span><span class="hljs-keyword">for</span></span><span> m </span><span><span class="hljs-keyword">in</span></span><span> models </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">any</span></span><span>(f </span><span><span class="hljs-keyword">in</span></span><span> m[</span><span><span class="hljs-string">'id'</span></span><span>] </span><span><span class="hljs-keyword">for</span></span><span> f </span><span><span class="hljs-keyword">in</span></span><span> free_indicators)]
    </span><span><span class="hljs-keyword">if</span></span><span> free_models:
        cfg[</span><span><span class="hljs-string">"model"</span></span><span>] = free_models[</span><span><span class="hljs-number">0</span></span><span>]  </span><span><span class="hljs-comment"># Pick the first free model</span></span><span>
        cfg[</span><span><span class="hljs-string">"max_tokens"</span></span><span>] = </span><span><span class="hljs-number">1024</span></span><span>
        save_config(cfg)
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"üñ§ Auto-selected free model: <span class="hljs-subst">{cfg[<span class="hljs-string">'model'</span></span></span></span><span>]} with max_tokens=1024")
        </span><span><span class="hljs-keyword">return</span></span><span>

    </span><span><span class="hljs-comment"># If no free models, pick the first available</span></span><span>
    cfg[</span><span><span class="hljs-string">"model"</span></span><span>] = models[</span><span><span class="hljs-number">0</span></span><span>][</span><span><span class="hljs-string">'id'</span></span><span>]
