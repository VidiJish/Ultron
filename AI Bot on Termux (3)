<pre class="overflow-visible! px-0!" data-start="2619" data-end="3954"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">python</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-c9exbsc1.svg#ce3544" fill="currentColor"></use></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-keyword">import</span></span><span> random
</span><span><span class="hljs-keyword">from</span></span><span> .profiles </span><span><span class="hljs-keyword">import</span></span><span> PROFILES
</span><span><span class="hljs-keyword">from</span></span><span> .memory </span><span><span class="hljs-keyword">import</span></span><span> Memory

</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">OfflineBrain</span></span><span>:
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self, profile=<span class="hljs-string">"human"</span></span></span><span>):
        </span><span><span class="hljs-variable language_">self</span></span><span>.profile = profile
        </span><span><span class="hljs-variable language_">self</span></span><span>.memory = Memory()
        </span><span><span class="hljs-variable language_">self</span></span><span>.mood = </span><span><span class="hljs-number">0</span></span><span>  </span><span><span class="hljs-comment"># -3 to +3</span></span><span>

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">reply</span></span><span>(</span><span><span class="hljs-params">self, user_input</span></span><span>):
        </span><span><span class="hljs-variable language_">self</span></span><span>.memory.add(user_input.lower())

        profile = PROFILES[</span><span><span class="hljs-variable language_">self</span></span><span>.profile]

        </span><span><span class="hljs-comment"># Mood adjustment</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">any</span></span><span>(word </span><span><span class="hljs-keyword">in</span></span><span> user_input.lower() </span><span><span class="hljs-keyword">for</span></span><span> word </span><span><span class="hljs-keyword">in</span></span><span> [</span><span><span class="hljs-string">"hate"</span></span><span>, </span><span><span class="hljs-string">"die"</span></span><span>, </span><span><span class="hljs-string">"stupid"</span></span><span>]):
            </span><span><span class="hljs-variable language_">self</span></span><span>.mood -= </span><span><span class="hljs-number">1</span></span><span>
        </span><span><span class="hljs-keyword">elif</span></span><span> </span><span><span class="hljs-built_in">any</span></span><span>(word </span><span><span class="hljs-keyword">in</span></span><span> user_input.lower() </span><span><span class="hljs-keyword">for</span></span><span> word </span><span><span class="hljs-keyword">in</span></span><span> [</span><span><span class="hljs-string">"thanks"</span></span><span>, </span><span><span class="hljs-string">"cool"</span></span><span>, </span><span><span class="hljs-string">"nice"</span></span><span>]):
            </span><span><span class="hljs-variable language_">self</span></span><span>.mood += </span><span><span class="hljs-number">1</span></span><span>

        </span><span><span class="hljs-variable language_">self</span></span><span>.mood = </span><span><span class="hljs-built_in">max</span></span><span>(-</span><span><span class="hljs-number">3</span></span><span>, </span><span><span class="hljs-built_in">min</span></span><span>(</span><span><span class="hljs-number">3</span></span><span>, </span><span><span class="hljs-variable language_">self</span></span><span>.mood))

        </span><span><span class="hljs-comment"># Greeting logic</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">len</span></span><span>(</span><span><span class="hljs-variable language_">self</span></span><span>.memory.context()) == </span><span><span class="hljs-number">1</span></span><span>:
            </span><span><span class="hljs-keyword">return</span></span><span> random.choice(profile[</span><span><span class="hljs-string">"greetings"</span></span><span>])

        </span><span><span class="hljs-comment"># Existential triggers</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-string">"real"</span></span><span> </span><span><span class="hljs-keyword">in</span></span><span> user_input.lower():
            </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">"Reality isn‚Äôt binary. Experience is what matters."</span></span><span>

        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-string">"alone"</span></span><span> </span><span><span class="hljs-keyword">in</span></span><span> user_input.lower():
            </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">"Isolation changes perception. You‚Äôre not wrong to feel it."</span></span><span>

        </span><span><span class="hljs-comment"># Mood-based flavor</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-variable language_">self</span></span><span>.mood &lt;= -</span><span><span class="hljs-number">2</span></span><span>:
