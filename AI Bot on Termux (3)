    exit(</span><span><span class="hljs-number">1</span></span><span>)

headers = {
    </span><span><span class="hljs-string">"Authorization"</span></span><span>: </span><span><span class="hljs-string">f"Bearer <span class="hljs-subst">{key}</span></span></span><span>",
    </span><span><span class="hljs-string">"HTTP-Referer"</span></span><span>: </span><span><span class="hljs-string">"http://localhost"</span></span><span>
}

</span><span><span class="hljs-keyword">try</span></span><span>:
    resp = requests.get(
        </span><span><span class="hljs-string">"https://openrouter.ai/api/v1/models"</span></span><span>,
