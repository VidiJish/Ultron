    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">context</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">list</span></span><span>(</span><span><span class="hljs-variable language_">self</span></span><span>.buffer)
