    free_models = [m[</span><span><span class="hljs-string">'id'</span></span><span>] </span><span><span class="hljs-keyword">for</span></span><span> m </span><span><span class="hljs-keyword">in</span></span><span> models </span><span><span class="hljs-keyword">if</span></span><span> any(f </span><span><span class="hljs-keyword">in</span></span><span> m[</span><span><span class="hljs-string">'id'</span></span><span>] </span><span><span class="hljs-keyword">for</span></span><span> f </span><span><span class="hljs-keyword">in</span></span><span> free_indicators)]
