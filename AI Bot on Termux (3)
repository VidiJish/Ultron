        </span><span><span class="hljs-keyword">return</span></span><span>

    models = fetch_models(api_key)
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> models:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è No models available"</span></span><span>)
        </span><span><span class="hljs-keyword">return</span></span><span>

    </span><span><span class="hljs-comment"># Show models with indices</span></span><span>
    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"\nAvailable models:"</span></span><span>)
    </span><span><span class="hljs-keyword">for</span></span><span> i, m </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">enumerate</span></span><span>(models):
