        </span><span><span class="hljs-string">"messages"</span></span><span>: [{</span><span><span class="hljs-string">"role"</span></span><span>: </span><span><span class="hljs-string">"user"</span></span><span>, </span><span><span class="hljs-string">"content"</span></span><span>: prompt}]
