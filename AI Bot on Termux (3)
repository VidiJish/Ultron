<hr data-start="1291" data-end="1294">
<h3 data-start="1296" data-end="1323">3Ô∏è‚É£ spycon.py Prototype</h3>
<pre class="overflow-visible! px-0!" data-start="1325" data-end="3210"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">python</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-c9exbsc1.svg#ce3544" fill="currentColor"></use></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-keyword">import</span></span><span> os, json, random
</span><span><span class="hljs-keyword">from</span></span><span> collections </span><span><span class="hljs-keyword">import</span></span><span> deque

</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Spycon</span></span><span>:
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self, path=<span class="hljs-string">"data/spycon.json"</span></span></span><span>, wiki_path=</span><span><span class="hljs-string">"data/wiki_cache.json"</span></span><span>, memory_limit=</span><span><span class="hljs-number">100</span></span><span>):
        </span><span><span class="hljs-variable language_">self</span></span><span>.path = path
        </span><span><span class="hljs-variable language_">self</span></span><span>.memory = deque(maxlen=memory_limit)
        </span><span><span class="hljs-variable language_">self</span></span><span>.wiki_path = wiki_path
        </span><span><span class="hljs-variable language_">self</span></span><span>.knowledge = {}
        </span><span><span class="hljs-variable language_">self</span></span><span>._load_knowledge()
        </span><span><span class="hljs-variable language_">self</span></span><span>._load_memory()

    </span><span><span class="hljs-comment"># ---------------- Memory ----------------</span></span><span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">_load_memory</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
        </span><span><span class="hljs-keyword">if</span></span><span> os.path.exists(</span><span><span class="hljs-variable language_">self</span></span><span>.path):
            </span><span><span class="hljs-variable language_">self</span></span><span>.memory.extend(json.load(</span><span><span class="hljs-built_in">open</span></span><span>(</span><span><span class="hljs-variable language_">self</span></span><span>.path)))

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">add_memory</span></span><span>(</span><span><span class="hljs-params">self, text</span></span><span>):
        </span><span><span class="hljs-variable language_">self</span></span><span>.memory.append(text)
        json.dump(</span><span><span class="hljs-built_in">list</span></span><span>(</span><span><span class="hljs-variable language_">self</span></span><span>.memory), </span><span><span class="hljs-built_in">open</span></span><span>(</span><span><span class="hljs-variable language_">self</span></span><span>.path, </span><span><span class="hljs-string">"w"</span></span><span>))

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">get_context</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">list</span></span><span>(</span><span><span class="hljs-variable language_">self</span></span><span>.memory)

    </span><span><span class="hljs-comment"># ---------------- Knowledge ----------------</span></span><span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">_load_knowledge</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
        </span><span><span class="hljs-keyword">if</span></span><span> os.path.exists(</span><span><span class="hljs-variable language_">self</span></span><span>.wiki_path):
            </span><span><span class="hljs-variable language_">self</span></span><span>.knowledge = json.load(</span><span><span class="hljs-built_in">open</span></span><span>(</span><span><span class="hljs-variable language_">self</span></span><span>.wiki_path))
        </span><span><span class="hljs-keyword">else</span></span><span>:
            </span><span><span class="hljs-variable language_">self</span></span><span>.knowledge = {}

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">update_knowledge</span></span><span>(</span><span><span class="hljs-params">self, new_docs</span></span><span>):
        <span class="hljs-string">"""
        new_docs: dict {topic: content}
        """</span>
        </span><span><span class="hljs-variable language_">self</span></span><span>.knowledge.update(new_docs)
        json.dump(</span><span><span class="hljs-variable language_">self</span></span><span>.knowledge, </span><span><span class="hljs-built_in">open</span></span><span>(</span><span><span class="hljs-variable language_">self</span></span><span>.wiki_path, </span><span><span class="hljs-string">"w"</span></span><span>))

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">query_knowledge</span></span><span>(</span><span><span class="hljs-params">self, topic</span></span><span>):
        topic_lower = topic.lower()
        </span><span><span class="hljs-keyword">for</span></span><span> key, content </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-variable language_">self</span></span><span>.knowledge.items():
            </span><span><span class="hljs-keyword">if</span></span><span> topic_lower </span><span><span class="hljs-keyword">in</span></span><span> key.lower():
                </span><span><span class="hljs-keyword">return</span></span><span> content
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>

    </span><span><span class="hljs-comment"># ---------------- Reply ----------------</span></span><span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">reply</span></span><span>(</span><span><span class="hljs-params">self, user_input</span></span><span>):
        </span><span><span class="hljs-variable language_">self</span></span><span>.add_memory(user_input)
        </span><span><span class="hljs-comment"># Check knowledge first</span></span><span>
        knowledge_reply = </span><span><span class="hljs-variable language_">self</span></span><span>.query_knowledge(user_input)
        </span><span><span class="hljs-keyword">if</span></span><span> knowledge_reply:
            </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">f"[Spycon Knowledge] <span class="hljs-subst">{knowledge_reply[:<span class="hljs-number">200</span></span></span></span><span>]}..."
        </span><span><span class="hljs-comment"># Default fallback</span></span><span>
        </span><span><span class="hljs-keyword">return</span></span><span> random.choice([
            </span><span><span class="hljs-string">"I ponder on that."</span></span><span>,
            </span><span><span class="hljs-string">"Knowledge grows slowly."</span></span><span>,
            </span><span><span class="hljs-string">"Perhaps you should reflect."</span></span><span>
        ])
</span></span></code></div></div></pre>
