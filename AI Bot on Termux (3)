        </span><span><span class="hljs-comment"># Idle fallback</span></span><span>
        </span><span><span class="hljs-keyword">return</span></span><span> random.choice(profile[</span><span><span class="hljs-string">"idle"</span></span><span>])
</span></span></code></div></div></pre>
