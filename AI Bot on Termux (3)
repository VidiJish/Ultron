    </span><span><span class="hljs-keyword">except</span></span><span>:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è Invalid choice"</span></span><span>)
        </span><span><span class="hljs-keyword">return</span></span><span>

    </span><span><span class="hljs-comment"># Auto-set max_tokens depending on model size</span></span><span>
    free_models = [</span><span><span class="hljs-string">"openrouter/auto"</span></span><span>, </span><span><span class="hljs-string">":free"</span></span><span>, </span><span><span class="hljs-string">"gpt-3.5"</span></span><span>, </span><span><span class="hljs-string">"gpt-4o-mini"</span></span><span>]
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">any</span></span><span>(tag </span><span><span class="hljs-keyword">in</span></span><span> selected </span><span><span class="hljs-keyword">for</span></span><span> tag </span><span><span class="hljs-keyword">in</span></span><span> free_models):
        max_tokens = </span><span><span class="hljs-number">1024</span></span><span>
    </span><span><span class="hljs-keyword">else</span></span><span>:
        max_tokens = </span><span><span class="hljs-number">2048</span></span><span>  </span><span><span class="hljs-comment"># default safe limit for paid models</span></span><span>

    cfg[</span><span><span class="hljs-string">"model"</span></span><span>] = selected
    cfg[</span><span><span class="hljs-string">"max_tokens"</span></span><span>] = max_tokens
    save_config(cfg)

    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"\n‚úÖ Model set to: <span class="hljs-subst">{selected}</span></span></span><span> with max_tokens=</span><span><span class="hljs-subst">{max_tokens}</span></span><span>")
</span></span></code></div></div></pre>
