import requests

def ask_openrouter(prompt, config):
    headers = {
        "Authorization": f"Bearer {config['openrouter_key']}",
        "Content-Type": "application/json"
    }

    data = {
        "model": config["model"],
        "messages": [
            {"role": "system", "content": open("config/personality.txt").read()},
            {"role": "user", "content": prompt}
        ]
    }

    r = requests.post(
        "https://openrouter.ai/api/v1/chat/completions",
        headers=headers,
        json=data,
        timeout=60
    )

    return r.json()["choices"][0]["message"]["content"]
