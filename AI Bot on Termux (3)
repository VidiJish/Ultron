import os, json, requests

CONFIG_PATH = </span><span><span class="hljs-string">"config/config.json"</span></span><span>

def load_config():
    with open(CONFIG_PATH) as f:
        </span><span><span class="hljs-built_in">return</span></span><span> json.load(f)

def save_config(cfg):
    with open(CONFIG_PATH, </span><span><span class="hljs-string">"w"</span></span><span>) as f:
        json.dump(cfg, f, indent=2)

def fetch_models(api_key):
    headers = {
        </span><span><span class="hljs-string">"Authorization"</span></span><span>: f</span><span><span class="hljs-string">"Bearer {api_key}"</span></span><span>,
        </span><span><span class="hljs-string">"HTTP-Referer"</span></span><span>: </span><span><span class="hljs-string">"http://localhost"</span></span><span>
    }
    try:
        resp = requests.get(</span><span><span class="hljs-string">"https://openrouter.ai/api/v1/models"</span></span><span>, headers=headers, </span><span><span class="hljs-built_in">timeout</span></span><span>=30)
        data = resp.json()
        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-string">"error"</span></span><span> </span><span><span class="hljs-keyword">in</span></span><span> data:
            </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è API Error:"</span></span><span>, data[</span><span><span class="hljs-string">"error"</span></span><span>])
            </span><span><span class="hljs-built_in">return</span></span><span> []
        </span><span><span class="hljs-built_in">return</span></span><span> data.get(</span><span><span class="hljs-string">"data"</span></span><span>, [])
    except Exception as e:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è Failed to fetch models:"</span></span><span>, e)
        </span><span><span class="hljs-built_in">return</span></span><span> []

def pick_model(auto_free=True):
    cfg = load_config()
    api_key = cfg.get(</span><span><span class="hljs-string">"openrouter_key"</span></span><span>)
    </span><span><span class="hljs-keyword">if</span></span><span> not api_key:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è Set OPENROUTER_API_KEY first in config.json"</span></span><span>)
        </span><span><span class="hljs-built_in">return</span></span><span>

    models = fetch_models(api_key)
    </span><span><span class="hljs-keyword">if</span></span><span> not models:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è No models available"</span></span><span>)
        </span><span><span class="hljs-built_in">return</span></span><span>

    free_indicators = [</span><span><span class="hljs-string">":free"</span></span><span>, </span><span><span class="hljs-string">"gpt-3.5"</span></span><span>, </span><span><span class="hljs-string">"gpt-4o-mini"</span></span><span>, </span><span><span class="hljs-string">"openrouter/auto"</span></span><span>]

    </span><span><span class="hljs-keyword">if</span></span><span> auto_free:
        </span><span><span class="hljs-comment"># Automatically pick first free model if current is premium</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> not any(f </span><span><span class="hljs-keyword">in</span></span><span> cfg.get(</span><span><span class="hljs-string">"model"</span></span><span>, </span><span><span class="hljs-string">""</span></span><span>) </span><span><span class="hljs-keyword">for</span></span><span> f </span><span><span class="hljs-keyword">in</span></span><span> free_indicators):
            </span><span><span class="hljs-keyword">for</span></span><span> m </span><span><span class="hljs-keyword">in</span></span><span> models:
                </span><span><span class="hljs-keyword">if</span></span><span> any(f </span><span><span class="hljs-keyword">in</span></span><span> m[</span><span><span class="hljs-string">'id'</span></span><span>] </span><span><span class="hljs-keyword">for</span></span><span> f </span><span><span class="hljs-keyword">in</span></span><span> free_indicators):
                    cfg[</span><span><span class="hljs-string">"model"</span></span><span>] = m[</span><span><span class="hljs-string">'id'</span></span><span>]
                    cfg[</span><span><span class="hljs-string">"max_tokens"</span></span><span>] = 1024
                    save_config(cfg)
                    </span><span><span class="hljs-built_in">print</span></span><span>(f</span><span><span class="hljs-string">"‚úÖ Auto-selected free model: {m['id']} with max_tokens=1024"</span></span><span>)
                    </span><span><span class="hljs-built_in">return</span></span><span>

    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"\nAvailable models (free models marked with üí∞FREE):\n"</span></span><span>)
    </span><span><span class="hljs-keyword">for</span></span><span> i, m </span><span><span class="hljs-keyword">in</span></span><span> enumerate(models):
        tag = </span><span><span class="hljs-string">"üí∞FREE"</span></span><span> </span><span><span class="hljs-keyword">if</span></span><span> any(f </span><span><span class="hljs-keyword">in</span></span><span> m[</span><span><span class="hljs-string">'id'</span></span><span>] </span><span><span class="hljs-keyword">for</span></span><span> f </span><span><span class="hljs-keyword">in</span></span><span> free_indicators) </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-string">""</span></span><span>
        </span><span><span class="hljs-built_in">print</span></span><span>(f</span><span><span class="hljs-string">"{i+1}. {m['id']} {tag}"</span></span><span>)

    choice = input(</span><span><span class="hljs-string">"\nSelect a model (number, Enter to skip auto): "</span></span><span>)
    </span><span><span class="hljs-keyword">if</span></span><span> choice.strip() == </span><span><span class="hljs-string">""</span></span><span>:
        </span><span><span class="hljs-built_in">return</span></span><span>  </span><span><span class="hljs-comment"># skip, keep auto-selected</span></span><span>
    try:
