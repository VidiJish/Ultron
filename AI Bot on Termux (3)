</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">load_config</span></span><span>():
    </span><span><span class="hljs-keyword">with</span></span><span> </span><span><span class="hljs-built_in">open</span></span><span>(CONFIG_PATH) </span><span><span class="hljs-keyword">as</span></span><span> f:
