            </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è API Error:"</span></span><span>, data[</span><span><span class="hljs-string">"error"</span></span><span>])
            </span><span><span class="hljs-keyword">return</span></span><span> []
        </span><span><span class="hljs-keyword">return</span></span><span> data.get(</span><span><span class="hljs-string">"data"</span></span><span>, [])
    </span><span><span class="hljs-keyword">except</span></span><span> Exception </span><span><span class="hljs-keyword">as</span></span><span> e:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"‚ö†Ô∏è Failed to fetch models:"</span></span><span>, e)
        </span><span><span class="hljs-keyword">return</span></span><span> []

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">pick_model</span></span><span>():
